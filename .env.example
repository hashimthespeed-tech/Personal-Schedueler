# Postgres. Neon's free tier is enough (https://neon.tech).
DATABASE_URL=postgresql://user:password@host/dbname

# Anthropic API key for the specialist agents and the nightly review.
ANTHROPIC_API_KEY=sk-ant-...

# Single-user auth. Any long random string.
SESSION_PASSWORD=change-me-to-at-least-32-characters-long
APP_PASSPHRASE=pick-something-only-you-know

# Web Push. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Protects the nightly replan cron endpoint.
CRON_SECRET=another-long-random-string
